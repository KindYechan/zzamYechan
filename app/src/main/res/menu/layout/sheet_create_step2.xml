<?xml version="1.0" encoding="utf-8"?>
<!--
    sheet_create_step2.xml — "새로운 행정반 생성하기" 2단계: 기능 / 관리 설정

    바텀시트 = 화면 아래에서 올라오는 창. Java에서 이렇게 띄워요:
      BottomSheetDialog sheet = new BottomSheetDialog(this);
      sheet.setContentView(R.layout.sheet_create_step2);
      sheet.show();
    시트 안의 뷰는 sheet.findViewById(R.id.xxx) 로 찾아요. (sheet. 을 꼭 붙이기!)
    닫기: btn_close 를 누르면 sheet.dismiss();

    체크 여부 읽기: ((CheckBox) sheet.findViewById(R.id.cb_feature_quest)).isChecked()
    스위치 읽기:   ((MaterialSwitch) sheet.findViewById(R.id.sw_activity_log)).isChecked()
    "이전"(btn_prev)을 누르면 1단계 시트로 돌아가기.
-->
<!-- 시트가 길어져도 키보드에 가려지지 않게 전체를 ScrollView 로 감쌌어요 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:scrollbars="none">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="21dp"
    android:paddingTop="23dp"
    android:paddingEnd="21dp"
    android:paddingBottom="24dp">

    <!-- 머리: 작은 머리말 + 제목 | 닫기(X) 버튼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_sheet_kicker"
                style="@style/JjamText.Kicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/create_kicker_step2" />

            <TextView
                android:id="@+id/tv_sheet_title"
                style="@style/JjamText.SheetTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/create_title_step2" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_close"
            android:layout_width="@dimen/icon_button"
            android:layout_height="@dimen/icon_button"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/action_close"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close"
            app:tint="@color/icon_default" />
    </LinearLayout>

    <!-- ───── 기능 추가: 2칸짜리 격자 ─────
         GridLayout 의 columnCount="2" 로 2열 배치.
         칩마다 layout_width="0dp" + layout_columnWeight="1" (스타일 JjamChip 안에 있음) → 두 칸이 같은 너비 -->
    <TextView
        style="@style/JjamText.BodyBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="@string/create_section_features"
        android:textSize="@dimen/text_caption" />

    <GridLayout
        android:id="@+id/grid_features"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="-4dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="-4dp"
        android:columnCount="2">

            <CheckBox
                android:id="@+id/cb_feature_calendar"
                style="@style/JjamChip"
                android:checked="true"
                android:text="@string/feature_calendar" />

            <CheckBox
                android:id="@+id/cb_feature_quest"
                style="@style/JjamChip"
                android:checked="true"
                android:text="@string/feature_quest" />

            <CheckBox
                android:id="@+id/cb_feature_promotion"
                style="@style/JjamChip"
                android:checked="true"
                android:text="@string/feature_promotion" />

            <CheckBox
                android:id="@+id/cb_feature_notice"
                style="@style/JjamChip"
                android:checked="true"
                android:text="@string/feature_notice" />

            <CheckBox
                android:id="@+id/cb_feature_alert"
                style="@style/JjamChip"
                android:checked="true"
                android:text="@string/feature_alert" />

            <CheckBox
                android:id="@+id/cb_feature_letter"
                style="@style/JjamChip"
                android:checked="false"
                android:text="@string/feature_letter" />
    </GridLayout>

    <!-- ───── 관리 설정 ───── -->
    <TextView
        style="@style/JjamText.BodyBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="@string/create_section_manage"
        android:textSize="@dimen/text_caption" />

    <!-- 한 줄: [수정 권한 ........ (선택 상자)] -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <TextView
            style="@style/JjamText.FormLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/label_edit_permission" />

        <Spinner
            android:id="@+id/sp_edit_permission"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_spinner_small"
            android:entries="@array/edit_permissions"
            android:paddingEnd="24dp"
            android:popupBackground="@color/surface" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/setting_line" />

    <!-- 한 줄: [활동 로그 / 설명 ........ (스위치)] -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/JjamText.FormLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_activity_log" />

            <TextView
                style="@style/JjamText.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/desc_activity_log"
                android:textSize="@dimen/text_tiny" />
        </LinearLayout>

        <!-- 켜짐/꺼짐 스위치. 색은 앱 테마의 colorPrimary 를 따라가요 -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sw_activity_log"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/setting_line" />

    <!-- [이전] [행정반 생성하기] 를 1 : 1 너비로 나란히 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_prev"
            style="@style/JjamButton.Secondary"
            android:layout_width="0dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:text="@string/action_prev" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_submit"
            style="@style/JjamButton"
            android:layout_width="0dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/create_submit" />
    </LinearLayout>

</LinearLayout>
</ScrollView>
