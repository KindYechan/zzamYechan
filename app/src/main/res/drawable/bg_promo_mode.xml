<?xml version="1.0" encoding="utf-8"?>
<!-- 판정 방식(평균 / 전부 통과) 선택 상자.
     글자가 두 줄이라 RadioButton 대신 LinearLayout 을 쓰고, Java 에서 setSelected(true/false) 로 선택 표시 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/promo_mode_checked_bg" />
            <stroke android:width="1dp" android:color="@color/promo_mode_checked_stroke" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/promo_mode_bg" />
            <stroke android:width="1dp" android:color="@color/promo_option_stroke" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
