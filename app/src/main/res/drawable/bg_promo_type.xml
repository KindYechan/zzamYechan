<?xml version="1.0" encoding="utf-8"?>
<!-- 항목 시트의 입력 방식(등급 / 통과) 선택 상자. setSelected(true/false) 로 선택 표시 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/promo_mode_checked_bg" />
            <stroke android:width="1dp" android:color="@color/promo_mode_checked_stroke" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <stroke android:width="1dp" android:color="@color/promo_option_stroke" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
