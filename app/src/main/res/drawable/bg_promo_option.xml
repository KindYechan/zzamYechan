<?xml version="1.0" encoding="utf-8"?>
<!-- 등급 / 합격 선택 버튼: 선택되면 진한 초록으로 채워짐 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/promo_option_checked" />
            <stroke android:width="1dp" android:color="@color/promo_option_checked_stroke" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/promo_option_bg" />
            <stroke android:width="1dp" android:color="@color/promo_option_stroke" />
            <corners android:radius="9dp" />
        </shape>
    </item>
</selector>
