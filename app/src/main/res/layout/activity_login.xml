<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_login.xml — 로그인 화면 (LoginActivity)
    앱을 켜면 가장 먼저 보이는 화면이에요.

    ══════════ 앱의 첫 화면으로 만들기 ══════════
    AndroidManifest.xml 에서 아래 <intent-filter> 를 MainActivity 에서 LoginActivity 로 옮기세요.
    이게 붙은 Activity 가 앱 아이콘을 눌렀을 때 열려요. (옮긴 쪽은 android:exported="true" 도 필요)
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>

    ══════════ 구현 순서 ══════════
    1) btn_go_signup → SignupActivity 로 이동 (finish 하지 않음: 뒤로 가기로 돌아올 수 있게)
    2) btn_login 클릭:
         String username = binding.etUsername.getText().toString().trim();
         String password = binding.etPassword.getText().toString();      // 비밀번호는 trim 하지 않는 게 안전
         비어 있으면 → 오류 상자에 R.string.auth_error_empty 보여 주고 return
    3) 로그인 시도: 서버가 준비되기 전에는 login(username, password) 메서드를 만들어 "가짜 성공" 처리
         성공 → MainActivity 로 이동 + finish()   (홈에서 뒤로 가기 했을 때 로그인 화면이 다시 나오지 않게)
         실패 → 오류 상자에 R.string.auth_error_login
    4) (선택) 처리 중 표시: 버튼을 누른 직후 btnLogin.setEnabled(false) + setText(R.string.auth_processing),
         결과가 오면 원래대로. 서버 연결 후 "두 번 누르기"를 막아 줘요.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_auth_screen">

    <!-- fillViewport: 내용이 짧으면 카드를 화면 가운데에, 길면(키보드가 올라오면) 스크롤 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <!-- ───────── 가운데 카드 ───────── -->
            <LinearLayout
                android:id="@+id/card_auth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/bg_auth_card"
                android:elevation="6dp"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="27dp"
                android:paddingEnd="24dp"
                android:paddingBottom="27dp">

                <!-- 로고 + 앱 이름 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="27dp"
                        android:layout_height="27dp"
                        android:background="@drawable/bg_brand_mark"
                        android:rotation="-4">

                        <ImageView
                            android:layout_width="10dp"
                            android:layout_height="14dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:rotation="35"
                            android:src="@drawable/ic_brand_mark_inner" />
                    </FrameLayout>

                    <TextView
                        style="@style/JjamText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:letterSpacing="-0.04"
                        android:text="@string/app_name"
                        android:textSize="@dimen/text_brand"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 머리말 / 제목 / 설명 -->
                <TextView
                    style="@style/JjamText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="31dp"
                    android:letterSpacing="0.03"
                    android:text="@string/auth_kicker"
                    android:textColor="@color/auth_kicker"
                    android:textSize="@dimen/text_tiny"
                    android:textStyle="bold" />

                <TextView
                    style="@style/JjamText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:letterSpacing="-0.04"
                    android:text="@string/auth_login_title"
                    android:textColor="@color/auth_title"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/JjamText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="11dp"
                    android:lineSpacingMultiplier="1.4"
                    android:text="@string/auth_login_desc"
                    android:textColor="@color/auth_desc"
                    android:textSize="@dimen/text_caption" />

                <!-- 아이디 -->
                <TextView
                    style="@style/AuthLabel"
                    android:text="@string/auth_label_username" />

                <EditText
                    android:id="@+id/et_username"
                    style="@style/JjamInput"
                    android:autofillHints="username"
                    android:hint="@string/auth_hint_username"
                    android:maxLength="32" />

                <!-- 비밀번호: inputType="textPassword" 라서 입력한 글자가 ●●● 로 가려져요 -->
                <TextView
                    style="@style/AuthLabel"
                    android:text="@string/auth_label_password" />

                <EditText
                    android:id="@+id/et_password"
                    style="@style/JjamInput"
                    android:autofillHints="password"
                    android:hint="@string/auth_hint_password"
                    android:inputType="textPassword" />

                <!-- "아직 계정이 없나요?  회원가입" -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/JjamText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auth_no_account"
                        android:textColor="@color/auth_desc"
                        android:textSize="@dimen/text_caption" />

                    <!-- 글자 버튼: TextView 에 clickable 을 켜서 버튼처럼 사용 -->
                    <TextView
                        android:id="@+id/btn_go_signup"
                        style="@style/JjamText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="6dp"
                        android:text="@string/auth_go_signup"
                        android:textColor="@color/auth_link"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 오류 메시지 상자: 처음엔 gone. 검사에 걸리면
                       binding.tvAuthError.setText(R.string.auth_error_password);
                       binding.tvAuthError.setVisibility(View.VISIBLE);
                     통과하면 다시 GONE. (tools:visibility 는 미리보기에서만 보이게 해 줘요) -->
                <TextView
                    android:id="@+id/tv_auth_error"
                    style="@style/JjamText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:background="@drawable/bg_auth_error"
                    android:padding="10dp"
                    android:text="@string/auth_error_login"
                    android:textColor="@color/auth_error_text"
                    android:textSize="@dimen/text_tiny"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_login"
                    style="@style/JjamButton"
                    android:layout_width="match_parent"
                    android:layout_marginTop="16dp"
                    android:text="@string/auth_login" />
            </LinearLayout>
        </FrameLayout>
    </ScrollView>
</FrameLayout>
