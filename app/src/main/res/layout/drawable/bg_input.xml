<?xml version="1.0" encoding="utf-8"?>
<!-- 입력칸 배경. 입력 중(state_focused)이면 테두리가 진해지고 두꺼워져요.
     selector 는 위에서부터 검사하므로 "조건 있는 항목"을 먼저, 기본값을 마지막에 둡니다. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <stroke android:width="1.5dp" android:color="@color/input_focus" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <stroke android:width="1dp" android:color="@color/input_stroke" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
