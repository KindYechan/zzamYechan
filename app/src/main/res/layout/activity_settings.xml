<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_settings.xml — 설정 화면 (SettingsActivity)
    홈 / 행정반 입장 화면 상단바의 ⚙ 버튼(binding.topBar.btnSettings)을 누르면 Intent 로 이동해 와요.
    뒤로 가기로 원래 화면에 돌아가야 하니, 이동할 때 finish() 하지 마세요.

    ┌ [<  설정]
    │ ┌ 프로필 카드: 이름 / 계급 · 전역일 ┐
    │ 내 정보   : 내 정보 수정 >, 진급일 관리 >
    │ 행정반    : 행정반 이름, 행정반 나가기 >
    │ 알림      : 전파사항 알림 (스위치)
    │ 계정      : 로그아웃 >, 회원 탈퇴 >
    └ 앱 버전 1.0.0

    ══════════ 구현 순서 ══════════
    1) btn_back → finish()
    2) 프로필 카드 채우기 (onCreate 에서)
         User user = UserManager.getCurrentUser();
         binding.tvProfileName.setText(user.getName());
         binding.tvProfileSub.setText(계급 + " · 전역일 " + user.getDischargeDate());
       행정반에 가입 안 했으면(user.getUnitCode() == null) 행정반 묶음(group_unit)을 GONE

    3) 로그아웃 (row_logout): 확인 창 → 로그아웃 → 로그인 화면 (쌓인 화면 모두 지우기)
         new AlertDialog.Builder(this)
                 .setMessage(R.string.set_logout_confirm)
                 .setPositiveButton(R.string.set_confirm_yes, (dialog, which) -> {
                     UserManager.logout();
                     Intent intent = new Intent(this, LoginActivity.class);
                     intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_CLEAR_TASK);
                     startActivity(intent);
                 })
                 .setNegativeButton(R.string.set_confirm_no, null)   // null = 그냥 닫기
                 .show();
       AlertDialog 는 androidx.appcompat.app.AlertDialog 를 import 하세요.
       행정반 나가기, 회원 탈퇴도 같은 확인 창 방식 (문구만 다름)

    4) 아직 없는 기능 (내 정보 수정, 진급일 관리, 회원 탈퇴 등)
         Toast.makeText(this, R.string.set_coming_soon, Toast.LENGTH_SHORT).show();

    5) 전파사항 알림 스위치: 지금은 값만 바뀌게 두고, 서버 알림이 붙으면 저장
         binding.swBroadcastAlert.setOnCheckedChangeListener((button, isChecked) -> { ... });
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- ═══════ 상단바: [< 설정] ═══════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="20dp">

        <LinearLayout
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/set_back"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="6dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/text_primary" />

            <TextView
                style="@style/JjamText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:letterSpacing="-0.03"
                android:text="@string/set_title"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/header_divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding_h"
            android:paddingTop="@dimen/screen_padding_top"
            android:paddingEnd="@dimen/screen_padding_h"
            android:paddingBottom="32dp">

            <!-- ═══════ 프로필 카드 (홈의 전역일 카드와 같은 짙은 초록) ═══════ -->
            <LinearLayout
                android:id="@+id/card_profile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_discharge_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <ImageView
                    android:id="@+id/img_profile"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_avatar_ring"
                    android:contentDescription="@string/home_profile_desc"
                    android:padding="2dp"
                    android:src="@drawable/img_avatar" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="13dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_profile_name"
                        style="@style/JjamText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/set_profile_name_sample"
                        android:textColor="@color/on_dark"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_profile_sub"
                        style="@style/JjamText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/set_profile_sub_sample"
                        android:textColor="@color/on_dark_secondary"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>
            </LinearLayout>

            <!-- ═══════ 내 정보 ═══════ -->
            <TextView
                style="@style/JjamText.Kicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="@string/set_section_profile"
                android:textColor="@color/set_section" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/row_edit_profile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp">

                    <ImageView
                        android:layout_width="@dimen/label_icon_box"
                        android:layout_height="@dimen/label_icon_box"
                        android:background="@drawable/bg_label_icon"
                        android:importantForAccessibility="no"
                        android:padding="5.5dp"
                        android:src="@drawable/ic_edit"
                        app:tint="@color/label_icon_tint" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="13dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/JjamText.BodyBold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/set_edit_profile" />

                        <TextView
                            android:id="@+id/tv_edit_profile_desc"
                            style="@style/JjamText.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/set_edit_profile_desc"
                            android:textSize="@dimen/text_tiny" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="6dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron"
                        app:tint="@color/nav_inactive" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="54dp"
                    android:background="@color/divider" />
                <LinearLayout
                    android:id="@+id/row_promotion_dates"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp">

                    <ImageView
                        android:layout_width="@dimen/label_icon_box"
                        android:layout_height="@dimen/label_icon_box"
                        android:background="@drawable/bg_label_icon"
                        android:importantForAccessibility="no"
                        android:padding="5.5dp"
                        android:src="@drawable/ic_rank"
                        app:tint="@color/label_icon_tint" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="13dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/JjamText.BodyBold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/set_promotion_dates" />

                        <TextView
                            android:id="@+id/tv_promotion_dates_desc"
                            style="@style/JjamText.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/set_promotion_dates_desc"
                            android:textSize="@dimen/text_tiny" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="6dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron"
                        app:tint="@color/nav_inactive" />
                </LinearLayout>
            </LinearLayout>

            <!-- ═══════ 행정반 (가입 안 했으면 이 묶음 전체를 GONE) ═══════ -->
            <LinearLayout
                android:id="@+id/group_unit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/JjamText.Kicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/set_section_unit"
                    android:textColor="@color/set_section" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/row_unit_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="56dp"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="10dp">

                        <ImageView
                            android:layout_width="@dimen/label_icon_box"
                            android:layout_height="@dimen/label_icon_box"
                            android:background="@drawable/bg_label_icon"
                            android:importantForAccessibility="no"
                            android:padding="5.5dp"
                            android:src="@drawable/ic_unit"
                            app:tint="@color/label_icon_tint" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="13dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/JjamText.BodyBold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/set_section_unit" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_unit_info_value"
                            style="@style/JjamText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/set_unit_sample"
                            android:textColor="@color/set_value"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="54dp"
                        android:background="@color/divider" />
                    <LinearLayout
                        android:id="@+id/row_leave_unit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="56dp"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="10dp">

                        <ImageView
                            android:layout_width="@dimen/label_icon_box"
                            android:layout_height="@dimen/label_icon_box"
                            android:background="@drawable/bg_set_danger_icon"
                            android:importantForAccessibility="no"
                            android:padding="5.5dp"
                            android:src="@drawable/ic_logout"
                            app:tint="@color/set_danger_text" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="13dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/JjamText.BodyBold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/set_leave_unit"
                                android:textColor="@color/set_danger_text" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="6dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron"
                            app:tint="@color/nav_inactive" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ═══════ 알림 ═══════ -->
            <TextView
                style="@style/JjamText.Kicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="@string/set_section_alert"
                android:textColor="@color/set_section" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/row_broadcast_alert"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp">

                    <ImageView
                        android:layout_width="@dimen/label_icon_box"
                        android:layout_height="@dimen/label_icon_box"
                        android:background="@drawable/bg_label_icon"
                        android:importantForAccessibility="no"
                        android:padding="5.5dp"
                        android:src="@drawable/ic_bell"
                        app:tint="@color/label_icon_tint" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="13dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/JjamText.BodyBold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/set_broadcast_alert" />

                        <TextView
                            android:id="@+id/tv_broadcast_alert_desc"
                            style="@style/JjamText.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/set_broadcast_alert_desc"
                            android:textSize="@dimen/text_tiny" />
                    </LinearLayout>

                    <!-- 켜짐/꺼짐 스위치 (행정반 생성 시트의 활동 로그와 같은 위젯) -->
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/sw_broadcast_alert"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>
            </LinearLayout>

            <!-- ═══════ 계정 ═══════ -->
            <TextView
                style="@style/JjamText.Kicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="@string/set_section_account"
                android:textColor="@color/set_section" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/row_logout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp">

                    <ImageView
                        android:layout_width="@dimen/label_icon_box"
                        android:layout_height="@dimen/label_icon_box"
                        android:background="@drawable/bg_label_icon"
                        android:importantForAccessibility="no"
                        android:padding="5.5dp"
                        android:src="@drawable/ic_logout"
                        app:tint="@color/label_icon_tint" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="13dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/JjamText.BodyBold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/set_logout" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="6dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron"
                        app:tint="@color/nav_inactive" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="54dp"
                    android:background="@color/divider" />
                <LinearLayout
                    android:id="@+id/row_delete_account"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp">

                    <ImageView
                        android:layout_width="@dimen/label_icon_box"
                        android:layout_height="@dimen/label_icon_box"
                        android:background="@drawable/bg_set_danger_icon"
                        android:importantForAccessibility="no"
                        android:padding="5.5dp"
                        android:src="@drawable/ic_close"
                        app:tint="@color/set_danger_text" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="13dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/JjamText.BodyBold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/set_delete_account"
                            android:textColor="@color/set_danger_text" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="6dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron"
                        app:tint="@color/nav_inactive" />
                </LinearLayout>
            </LinearLayout>

            <!-- ═══════ 앱 버전 ═══════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    style="@style/JjamText.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/set_app_version" />

                <TextView
                    android:id="@+id/tv_app_version"
                    style="@style/JjamText.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/set_app_version_sample" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</LinearLayout>
