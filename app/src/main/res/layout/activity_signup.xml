<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_signup.xml — 회원가입 화면 (SignupActivity)
    로그인 화면의 "회원가입"을 누르면 열려요. 입력한 값으로 User 객체를 만드는 화면이에요.

    ══════════ 입력값과 User 클래스 ══════════
      et_username      → 아이디          (User 에 저장)
      et_password      → 비밀번호         (⚠ User 에 저장하지 않음. 서버 로그인 기능에 전달만)
      et_name          → 이름
      rg_member_type   → 유형: rb_soldier = "soldier" / rb_officer = "officer"
      sp_rank          → 계급 (병사일 때만). 코드로 바꾸는 방법은 arrays_auth.xml 주석 참고. 간부는 null
      tv_enlist_date   → 입대일 "2026-11-16" 형식
      tv_discharge_date→ 전역일

    ══════════ 구현 순서 ══════════
    1) 유형 전환: 간부를 고르면 계급 칸 숨기기
         binding.rgMemberType.setOnCheckedChangeListener((group, checkedId) -> {
             boolean soldier = checkedId == R.id.rb_soldier;
             binding.layoutRank.setVisibility(soldier ? View.VISIBLE : View.GONE);
         });

    2) 날짜: 화면이 열릴 때 입대일 = 오늘, 전역일 = 오늘 + 18개월 로 채우기
         Calendar c = Calendar.getInstance();          // 오늘
         c.add(Calendar.MONTH, 18);                     // 18개월 뒤 (연도 넘어가는 것도 알아서 계산)
         글자로 바꾸기: String.format(Locale.KOREA, "%d-%02d-%02d", 년, 월 + 1, 일)   ← 월은 0부터라 +1
       날짜 칸을 누르면 DatePickerDialog:
         new DatePickerDialog(this, (picker, y, m, d) -> { ... }, 년, 월, 일).show();
       입대일을 바꾸면 전역일도 "새 입대일 + 18개월"로 다시 계산 (전역일은 그 뒤 직접 수정 가능)
       Tip: 입대일/전역일을 Calendar 필드 두 개로 기억해 두면 비교와 계산이 쉬워요.

    3) btn_signup 클릭 → 검사 (걸리면 오류 상자에 표시하고 return). 디자인 코드의 규칙 그대로:
         아이디   : username.matches("[a-zA-Z0-9_-]{4,32}")  아니면 auth_error_username
         비밀번호 : password.length() < 8                     이면 auth_error_password
         이름     : name.isEmpty()                            이면 auth_error_name
         날짜     : 전역일이 입대일보다 앞 (discharge.before(enlist)) 이면 auth_error_dates

    4) 통과하면 User 객체 만들기 → (가짜) 회원가입 처리 → MainActivity 로 이동
         이때 로그인 화면까지 한꺼번에 닫으려면:
           intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_CLEAR_TASK);
         (쌓여 있던 화면을 모두 지우고 새로 시작한다는 뜻)

    5) btn_go_login → finish()  (아래에 깔려 있는 로그인 화면으로 돌아감)
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_auth_screen">

    <!-- fillViewport: 내용이 짧으면 카드를 화면 가운데에, 길면(키보드가 올라오면) 스크롤 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <!-- ───────── 가운데 카드 ───────── -->
            <LinearLayout
                android:id="@+id/card_auth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/bg_auth_card"
                android:elevation="6dp"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="27dp"
                android:paddingEnd="24dp"
                android:paddingBottom="27dp">

                <!-- 로고 + 앱 이름 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="27dp"
                        android:layout_height="27dp"
                        android:background="@drawable/bg_brand_mark"
                        android:rotation="-4">

                        <ImageView
                            android:layout_width="10dp"
                            android:layout_height="14dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:rotation="35"
                            android:src="@drawable/ic_brand_mark_inner" />
                    </FrameLayout>

                    <TextView
                        style="@style/JjamText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:letterSpacing="-0.04"
                        android:text="@string/app_name"
                        android:textSize="@dimen/text_brand"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 머리말 / 제목 / 설명 -->
                <TextView
                    style="@style/JjamText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="31dp"
                    android:letterSpacing="0.03"
                    android:text="@string/auth_kicker"
                    android:textColor="@color/auth_kicker"
                    android:textSize="@dimen/text_tiny"
                    android:textStyle="bold" />

                <TextView
                    style="@style/JjamText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:letterSpacing="-0.04"
                    android:text="@string/auth_signup_title"
                    android:textColor="@color/auth_title"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/JjamText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="11dp"
                    android:lineSpacingMultiplier="1.4"
                    android:text="@string/auth_signup_desc"
                    android:textColor="@color/auth_desc"
                    android:textSize="@dimen/text_caption" />

                <!-- 아이디 -->
                <TextView
                    style="@style/AuthLabel"
                    android:text="@string/auth_label_username" />

                <EditText
                    android:id="@+id/et_username"
                    style="@style/JjamInput"
                    android:autofillHints="username"
                    android:hint="@string/auth_hint_username"
                    android:maxLength="32" />

                <!-- 비밀번호: inputType="textPassword" 라서 입력한 글자가 ●●● 로 가려져요 -->
                <TextView
                    style="@style/AuthLabel"
                    android:text="@string/auth_label_password" />

                <EditText
                    android:id="@+id/et_password"
                    style="@style/JjamInput"
                    android:autofillHints="password"
                    android:hint="@string/auth_hint_password"
                    android:inputType="textPassword" />

                <!-- 이름 -->
                <TextView
                    style="@style/AuthLabel"
                    android:text="@string/auth_label_name" />

                <EditText
                    android:id="@+id/et_name"
                    style="@style/JjamInput"
                    android:autofillHints="name"
                    android:hint="@string/auth_hint_name"
                    android:inputType="textPersonName"
                    android:maxLength="40" />

                <!-- 유형: 병사 | 간부. RadioGroup 이라 하나만 선택되는 건 자동 (전파사항 유형과 같은 방식) -->
                <TextView
                    style="@style/AuthLabel"
                    android:text="@string/auth_label_member_type" />

                <RadioGroup
                    android:id="@+id/rg_member_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:checkedButton="@+id/rb_soldier"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rb_soldier"
                        style="@style/JjamOption"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:text="@string/auth_type_soldier" />

                    <RadioButton
                        android:id="@+id/rb_officer"
                        style="@style/JjamOption"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="7dp"
                        android:layout_weight="1"
                        android:text="@string/auth_type_officer" />
                </RadioGroup>

                <!-- 계급: 이름표와 선택 상자를 한 상자로 묶어서, 간부일 때 한 번에 숨길 수 있게 함 -->
                <LinearLayout
                    android:id="@+id/layout_rank"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/AuthLabel"
                        android:text="@string/auth_label_rank" />

                    <Spinner
                        android:id="@+id/sp_rank"
                        style="@style/JjamSpinner"
                        android:entries="@array/auth_ranks" />
                </LinearLayout>

                <!-- 입대일 | 전역일 (반반). 누르면 DatePickerDialog -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4.5dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/AuthLabel"
                            android:text="@string/auth_label_enlist_date" />

                        <TextView
                            android:id="@+id/tv_enlist_date"
                            style="@style/AuthDateField"
                            tools:text="@string/auth_date_sample" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4.5dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/AuthLabel"
                            android:text="@string/auth_label_discharge_date" />

                        <TextView
                            android:id="@+id/tv_discharge_date"
                            style="@style/AuthDateField"
                            tools:text="@string/auth_date_sample" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/JjamText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingMultiplier="1.3"
                    android:text="@string/auth_date_help"
                    android:textColor="@color/auth_help"
                    android:textSize="@dimen/text_tiny" />

                <!-- 오류 메시지 상자: 처음엔 gone. 검사에 걸리면
                       binding.tvAuthError.setText(R.string.auth_error_password);
                       binding.tvAuthError.setVisibility(View.VISIBLE);
                     통과하면 다시 GONE. (tools:visibility 는 미리보기에서만 보이게 해 줘요) -->
                <TextView
                    android:id="@+id/tv_auth_error"
                    style="@style/JjamText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:background="@drawable/bg_auth_error"
                    android:padding="10dp"
                    android:text="@string/auth_error_login"
                    android:textColor="@color/auth_error_text"
                    android:textSize="@dimen/text_tiny"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_signup"
                    style="@style/JjamButton"
                    android:layout_width="match_parent"
                    android:layout_marginTop="16dp"
                    android:text="@string/auth_signup" />

                <!-- "이미 계정이 있어요 · 로그인" 글자 버튼 -->
                <TextView
                    android:id="@+id/btn_go_login"
                    style="@style/JjamText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:padding="10dp"
                    android:text="@string/auth_go_login"
                    android:textColor="@color/auth_desc"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>
        </FrameLayout>
    </ScrollView>
</FrameLayout>
