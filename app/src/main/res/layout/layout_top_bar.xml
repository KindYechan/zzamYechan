<?xml version="1.0" encoding="utf-8"?>
<!--
    layout_top_bar.xml — 홈 / 행정반 입장 화면이 같이 쓰는 상단바
    다른 레이아웃에서 <include layout="@layout/layout_top_bar" /> 로 불러 씁니다.
    [로고 ■ 짬인지]                        [🔔] [⚙]
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/top_bar"
    android:layout_width="match_parent"
    android:layout_height="@dimen/top_bar_height"
    android:background="@color/background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="22dp"
    android:paddingEnd="16dp">

    <!-- 로고 마크: 살짝 기울어진(rotation) 초록 사각형 -->
    <FrameLayout
        android:layout_width="27dp"
        android:layout_height="27dp"
        android:background="@drawable/bg_brand_mark"
        android:rotation="-4">

        <ImageView
            android:layout_width="10dp"
            android:layout_height="14dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:rotation="35"
            android:src="@drawable/ic_brand_mark_inner" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_brand"
        style="@style/JjamText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="9dp"
        android:letterSpacing="-0.04"
        android:text="@string/app_name"
        android:textSize="@dimen/text_brand"
        android:textStyle="bold" />

    <!-- 빈 공간을 늘려서 오른쪽 버튼들을 끝으로 밀어냄 -->
    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- contentDescription: 화면 낭독기(TalkBack)가 읽어주는 이름. 아이콘 버튼엔 꼭 넣어주세요 -->
    <ImageButton
        android:id="@+id/btn_notifications"
        android:layout_width="@dimen/icon_button"
        android:layout_height="@dimen/icon_button"
        android:background="@drawable/bg_icon_button"
        android:contentDescription="@string/action_notifications"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_bell"
        app:tint="@color/icon_default" />

    <ImageButton
        android:id="@+id/btn_settings"
        android:layout_width="@dimen/icon_button"
        android:layout_height="@dimen/icon_button"
        android:layout_marginStart="7dp"
        android:background="@drawable/bg_icon_button"
        android:contentDescription="@string/action_settings"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_settings"
        app:tint="@color/icon_default" />

</LinearLayout>
