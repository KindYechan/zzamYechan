<?xml version="1.0" encoding="utf-8"?>
<!--
    layout_promotion_rank_tabs.xml — 상병 / 병장 탭 (진급 계산기와 진급 기준 설정이 같이 씀)
    RadioGroup 이라 하나만 선택되는 건 자동이에요.

    쓰는 쪽에서 <include android:id="@+id/rank_tabs" ... /> 로 불러오면:
      RadioGroup tabs = binding.rankTabs.getRoot();
      tabs.setOnCheckedChangeListener((group, checkedId) -> {
          String rank = (checkedId == R.id.rb_tab_corporal) ? "corporal" : "sergeant";
          // 그 계급의 규칙으로 화면 다시 그리기
      });
-->
<RadioGroup xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_promo_tabs"
    android:checkedButton="@+id/rb_tab_corporal"
    android:orientation="horizontal"
    android:padding="4dp">

    <RadioButton
        android:id="@+id/rb_tab_corporal"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_weight="1"
        android:background="@drawable/bg_promo_tab"
        android:button="@null"
        android:gravity="center"
        android:text="@string/promo_rank_corporal"
        android:textColor="@color/promo_tab_text_selector"
        android:textSize="13sp"
        android:textStyle="bold" />

    <RadioButton
        android:id="@+id/rb_tab_sergeant"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_weight="1"
        android:background="@drawable/bg_promo_tab"
        android:button="@null"
        android:gravity="center"
        android:text="@string/promo_rank_sergeant"
        android:textColor="@color/promo_tab_text_selector"
        android:textSize="13sp"
        android:textStyle="bold" />
</RadioGroup>
