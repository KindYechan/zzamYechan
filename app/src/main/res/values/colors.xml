    <color name="text_kicker">#FF77907E</color>
    <color name="icon_default">#FF4B5D52</color>

    <!-- 카드 라벨 아이콘 (작은 둥근 사각형 배경) -->
    <color name="label_icon_bg">#FFE8EEE2</color>
    <color name="label_icon_tint">#FF41694F</color>

    <!-- 짙은 카드(전역일 카드) 위의 글자 -->
