<?xml version="1.0" encoding="utf-8"?>
<!--
    짬인지 색상 팔레트 (피그마 Make의 index.css 값을 그대로 옮김)
    색은 "역할" 이름으로 지었어요. 레이아웃에서는 @color/이름 으로만 쓰고,
    색을 바꾸고 싶으면 이 파일 한 곳만 고치면 앱 전체에 반영됩니다.
    #AARRGGBB 형식에서 앞 두 자리(AA)는 투명도예요. 예) #29FFFFFF = 흰색 16%
-->
<resources>
    <!-- 브랜드 / 주 색상 (짙은 국방색 계열) -->
    <color name="primary">#FF345D46</color>
    <color name="primary_dark">#FF244C39</color>
    <color name="primary_light">#FF3D674F</color>
    <color name="brand_mark">#FF325B45</color>
    <color name="brand_mark_inner">#FFDCE8C9</color>

    <!-- 배경 / 표면 -->
    <color name="background">#FFF5F6F1</color>
    <color name="surface">#FFFFFFFF</color>
    <color name="surface_soft">#FFF5F7F1</color>
    <color name="surface_soft2">#FFF6F7F3</color>
    <color name="card_stroke">#FFE7EBE4</color>
    <color name="divider">#FFEDF0EB</color>
