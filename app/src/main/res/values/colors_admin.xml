<?xml version="1.0" encoding="utf-8"?>
<!--
    행정반 전용 색 (입장 화면, 대시보드, 메뉴, 전파사항·마음의 편지 창)

    리소스는 "파일 이름"이 아니라 항목의 name 으로 찾기 때문에,
    어느 파일에 있든 @color/이름, R.color.이름 으로 똑같이 쓸 수 있어요.
    여러 화면이 쓰는 항목은 공용 파일(colors.xml), 한 화면만 쓰는 항목은 화면별 파일에 둡니다.
-->
<resources>
    <!-- 짙은 카드(전역일 카드) 위의 글자 -->
    <color name="on_dark_icon_bg">#21FFFFFF</color>

    <!-- 행정반 입장 화면 -->
