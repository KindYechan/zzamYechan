<?xml version="1.0" encoding="utf-8"?>
<!--
    홈 화면(activity_main) 전용 색

    리소스는 "파일 이름"이 아니라 항목의 name 으로 찾기 때문에,
    어느 파일에 있든 @color/이름, R.color.이름 으로 똑같이 쓸 수 있어요.
    여러 화면이 쓰는 항목은 공용 파일(colors.xml), 한 화면만 쓰는 항목은 화면별 파일에 둡니다.
-->
<resources>
    <!-- 배경 / 표면 -->
    <color name="surface_soft">#FFF5F7F1</color>

    <!-- 글자색 -->
    <color name="text_secondary">#FF52645A</color>

    <!-- 짙은 카드(전역일 카드) 위의 글자 -->
    <color name="on_dark_muted">#FFB9CCBC</color>
    <color name="on_dark_line">#21FFFFFF</color>
    <color name="promo_track">#29FFFFFF</color>
    <color name="promo_progress">#FFCBDCAE</color>

    <!-- 월급 / 적금 카드 -->
    <color name="saving_bg">#FFEDF1E8</color>
    <color name="saving_stroke">#FFE0E7DC</color>

    <!-- 캘린더 -->
    <color name="today_bg">#FF365E48</color>
    <color name="today_sub">#FFD8E5D6</color>
    <color name="event_dot">#FF9AAA8F</color>
    <color name="event_dot_today">#FFDBE9C4</color>
    <color name="time_badge_bg">#FFE3EBDE</color>
    <color name="time_badge_text">#FF376047</color>

    <!-- 퀘스트 / 경험치 -->
    <color name="xp_reward">#FF54725C</color>
    <color name="urgent">#FFB35B4E</color>
    <color name="dday_text">#FFA45649</color>
    <color name="dday_bg">#FFF7E9E5</color>
</resources>
